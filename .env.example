# GoToSocial deploy — documented environment variables.
# Copy to .env only if you deploy outside Railway; on Railway these are
# service variables (the deploy form sets GTS_HOST + GTS_ADMIN_PASSWORD).

# Public domain of this instance (bare hostname, no scheme). Permanent
# federation identity — baked into account URIs at first boot.
GTS_HOST=

# Password for the seeded first admin account (username "admin").
GTS_ADMIN_PASSWORD=

# --- Baked into the Dockerfile as defaults; override via service variables ---
# GTS_ADMIN_USERNAME=admin
# GTS_ADMIN_EMAIL=admin@example.com
# GTS_DB_TYPE=sqlite
# GTS_DB_ADDRESS=/data/sqlite.db
# GTS_STORAGE_BACKEND=local
# GTS_STORAGE_LOCAL_BASE_PATH=/data/storage
# GTS_WAZERO_COMPILATION_CACHE=/data/.cache
# GTS_LETSENCRYPT_ENABLED=false
# GTS_PROTOCOL=https
# GTS_ACCOUNTS_REGISTRATION_OPEN=false
# GTS_ACCOUNTS_APPROVAL_REQUIRED=true

# --- Optional, set after install + redeploy (see README) ---
# GTS_SMTP_HOST=
# GTS_SMTP_PORT=
# GTS_SMTP_USERNAME=
# GTS_SMTP_PASSWORD=
# GTS_SMTP_FROM=
# GTS_TRUSTED_PROXIES=
# GTS_INSTANCE_TITLE=
# GTS_INSTANCE_SHORT_DESCRIPTION=
# GTS_INSTANCE_DESCRIPTION=
